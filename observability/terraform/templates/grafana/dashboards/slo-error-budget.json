          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "(1 - avg_over_time(probe_success[6h])) / (1 - 0.995)",
          "legendFormat": "Burn Rate (6h window)",
          "refId": "B"
        }
      ],
      "title": "Burn Rate (thresholds: 5x slow burn, 14.4x fast burn)",
      "type": "timeseries"
    },
